          "name": "TC-001 Search — pipe",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('search_type is hybrid', () => pm.expect(b.search_type).to.eql('hybrid'));",
            "pm.test('results not empty', () => pm.expect(b.results.length).to.be.above(0));",
            "pm.test('at least one result has Pipe in name', () => {",
            "  const hit = b.results.find(r => r.source.productName_en && r.source.productName_en.toLowerCase().includes('pipe'));",
            "  pm.expect(hit, 'No pipe product found').to.exist;",
            "});",
            "pm.test('facets present', () => pm.expect(b.facets.length).to.be.above(0));",
            "pm.test('request_id is UUID', () => pm.expect(b.request_id).to.match(/^[0-9a-f-]{36}$/));",
            "pm.test('took_ms > 0', () => pm.expect(b.took_ms).to.be.above(0));",
            "pm.test('page and page_size correct', () => { pm.expect(b.page).to.eql(1); pm.expect(b.page_size).to.eql(10); });"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/v1/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
