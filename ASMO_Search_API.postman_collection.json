    {
      "name": "Health & Infra",
      "item": [
        {
          "name": "TC-000 Health Check",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('status field present', () => pm.expect(b).to.have.property('status'));",
            "pm.test('opensearch_connected is bool', () => pm.expect(typeof b.opensearch_connected).to.eql('boolean'));",
            "pm.test('embedding_model_name present', () => pm.expect(b.embedding_model_name).to.be.a('string').and.not.empty);"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        },
        {
          "name": "TC-000 List Indices",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('indices is array', () => pm.expect(b.indices).to.be.an('array'));",
            "pm.test('total matches array length', () => pm.expect(b.total).to.eql(b.indices.length));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/indices" }
        }
      ]
    },
