    {
      "name": "Sort",
      "item": [
        {
          "name": "TC-009 Sort by price asc",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('results not empty', () => pm.expect(b.results.length).to.be.above(1));",
            "pm.test('prices are ascending', () => {",
            "  const prices = b.results.map(r => r.source.price).filter(p => p != null);",
            "  for (let i = 1; i < prices.length; i++) {",
            "    pm.expect(prices[i]).to.be.at.least(prices[i-1], `Price at index ${i} (${prices[i]}) is less than price at ${i-1} (${prices[i-1]})`);",
            "  }",
            "});"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/v1/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"search_query\": \"valve\",\n  \"language\": \"en\",\n  \"sort_by\": \"price\",\n  \"sort_order\": \"asc\",\n  \"page\": 1,\n  \"page_size\": 10\n}" }
          }
        },
        {
          "name": "TC-010 Sort by price desc",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('results not empty', () => pm.expect(b.results.length).to.be.above(1));",
            "pm.test('prices are descending', () => {",
            "  const prices = b.results.map(r => r.source.price).filter(p => p != null);",
            "  for (let i = 1; i < prices.length; i++) {",
            "    pm.expect(prices[i]).to.be.at.most(prices[i-1], `Price at index ${i} (${prices[i]}) is greater than price at ${i-1} (${prices[i-1]})`);",
            "  }",
            "});"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/v1/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
