{
  "openapi": "3.1.0",
  "info": {
    "title": "ASMO AI Search API",
    "description": "Frontend contract v2.1 — text/image/filter search with hybrid BM25 + kNN (RRF) and suggestions",
    "version": "2.1.0"
  },
  "paths": {
    "/indices": {
      "get": {
        "tags": [
          "Indices"
        ],
        "summary": "List all indices",
        "operationId": "list_indices_indices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — unsupported channel/language, invalid filter, unknown request_id, or empty request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found — the target index does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large — uploaded image exceeds the size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "tags": [
          "V1 Search API"
        ],
        "summary": "Search products (text / image / text+image / filter-browse)",
        "operationId": "v1_search_v1_search_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "Client channel — 'web' or 'mobile'"
                  },
                  "language": {
                    "type": "string",
                    "title": "Language",
                    "description": "Response language — 'en'"
                  },
                  "search_query": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Search Query",
                    "description": "Free-text query. Omit for filter-only browse"
                  },
                  "sort_by": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Sort By",
                    "description": "Sort field — 'relevance' or 'price'"
                  },
                  "sort_order": {
                    "type": "string",
                    "title": "Sort Order",
                    "description": "Sort direction — 'asc' or 'desc'",
                    "default": "desc"
                  },
                  "filters": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Filters",
                    "description": "Filter object encoded as a JSON string, e.g. {\"category_name\": [\"<category id>\"], \"price\": {\"gte\": 50, \"lte\": 150}}. Every facet key is a filter key and takes the facet's id: category_name, sub_category_name, product_type, sellername, material_type. Also: price, moq, lead_time (number or range), availability, category_ids, currency, contract_indicator, temporary_unavailable, supplier_count, sub_category_id, product_type_id, sold_by, sku_id, product_key, asmo_material_number, aramco_material_number. A value may be a list (match any); numeric keys also take {gt, gte, lt, lte}. Any other key -> 400 INVALID_FILTER_KEY"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1.0,
                    "title": "Page",
                    "description": "1-based page number",
                    "default": 1
                  },
                  "page_size": {
                    "type": "integer",
                    "maximum": 200.0,
                    "minimum": 1.0,
                    "title": "Page Size",
                    "description": "Results per page (frontend default 60)",
                    "default": 60
                  },
                  "request_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Request Id",
                    "description": "request_id of a previous response: refines that search — its query and/or image are reused for whichever of search_query / image is omitted"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional image for image / text+image search, as a binary multipart part (image/jpeg, image/png, image/webp or application/octet-stream). The bytes must be a JPEG, PNG or WebP image, max 10 MiB; GIF and other formats get 400, larger files 413"
                  }
                },
                "type": "object",
                "required": [
                  "channel",
                  "language"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — unsupported channel/language, invalid filter, unknown request_id, or empty request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found — the target index does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large — uploaded image exceeds the size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable — a request_id was sent but the search-context store (Redis) is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/suggestions": {
      "get": {
        "tags": [
          "V1 Search API"
        ],
        "summary": "Autocomplete suggestions",
        "operationId": "v1_suggestions_v1_search_suggestions_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Partial text entered by the user",
              "title": "Q"
            },
            "description": "Partial text entered by the user"
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client channel — 'web' or 'mobile'",
              "title": "Channel"
            },
            "description": "Client channel — 'web' or 'mobile'"
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Response language — 'en'",
              "title": "Language"
            },
            "description": "Response language — 'en'"
          },
          {
            "name": "query_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Max query suggestions to return",
              "default": 5,
              "title": "Query Limit"
            },
            "description": "Max query suggestions to return"
          },
          {
            "name": "product_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Max product suggestions to return",
              "default": 5,
              "title": "Product Limit"
            },
            "description": "Max product suggestions to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — unsupported channel/language, invalid filter, unknown request_id, or empty request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found — the target index does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large — uploaded image exceeds the size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/latency/opensearch": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Latency Opensearch",
        "description": "Measure round-trip latency to OpenSearch (one GET / per sample).",
        "operationId": "latency_opensearch_health_latency_opensearch_get",
        "parameters": [
          {
            "name": "samples",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "title": "Samples"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatencyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/latency/redis": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Latency Redis",
        "description": "Measure round-trip latency to Redis (one PING per sample).",
        "operationId": "latency_redis_health_latency_redis_get",
        "parameters": [
          {
            "name": "samples",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "title": "Samples"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatencyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/latency/oci": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Latency Oci",
        "description": "Measure round-trip latency to OCI GenAI (one embed call per sample).",
        "operationId": "latency_oci_health_latency_oci_get",
        "parameters": [
          {
            "name": "samples",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "title": "Samples"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatencyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable, machine-readable backend error identifier, e.g. INVALID_FILTER_KEY"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable description suitable for frontend handling or display"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "FacetTermValue": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Value to send back as the filter for this facet (the category / sub-category / product-type / seller id, or the material type)"
          },
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Facet bucket label to display"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Number of matching products with this value"
          }
        },
        "type": "object",
        "required": [
          "id",
          "value",
          "count"
        ],
        "title": "FacetTermValue"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall API health: 'ok' when all dependencies are reachable, 'degraded' otherwise"
          },
          "opensearch_connected": {
            "type": "boolean",
            "title": "Opensearch Connected",
            "description": "Whether the API successfully pinged the OpenSearch cluster"
          },
          "opensearch_cluster": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opensearch Cluster",
            "description": "Cluster name returned by OpenSearch, null if unreachable"
          },
          "embedding_model_loaded": {
            "type": "boolean",
            "title": "Embedding Model Loaded",
            "description": "Whether the embedding model client has been initialized"
          },
          "embedding_model_name": {
            "type": "string",
            "title": "Embedding Model Name",
            "description": "OCI GenAI model identifier used for query embedding"
          },
          "redis_connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis Connected",
            "description": "Whether Redis (embedding cache) answered PING; null when Redis is disabled"
          }
        },
        "type": "object",
        "required": [
          "status",
          "opensearch_connected",
          "embedding_model_loaded",
          "embedding_model_name"
        ],
        "title": "HealthResponse"
      },
      "IndexInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Index name in OpenSearch"
          },
          "doc_count": {
            "type": "integer",
            "title": "Doc Count",
            "description": "Number of documents currently in the index"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes",
            "description": "Total on-disk size of the index in bytes"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Index health status as reported by OpenSearch, e.g. green, yellow, red"
          }
        },
        "type": "object",
        "required": [
          "name",
          "doc_count",
          "size_bytes",
          "status"
        ],
        "title": "IndexInfo"
      },
      "IndicesResponse": {
        "properties": {
          "indices": {
            "items": {
              "$ref": "#/components/schemas/IndexInfo"
            },
            "type": "array",
            "title": "Indices",
            "description": "List of non-system indices available in the cluster"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total number of indices returned"
          }
        },
        "type": "object",
        "required": [
          "indices",
          "total"
        ],
        "title": "IndicesResponse"
      },
      "LatencyResponse": {
        "properties": {
          "target": {
            "type": "string",
            "title": "Target",
            "description": "Which dependency was measured: 'opensearch', 'redis' or 'oci'"
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint",
            "description": "Host/endpoint that was contacted"
          },
          "samples": {
            "type": "integer",
            "title": "Samples",
            "description": "Number of round-trips attempted"
          },
          "samples_ms": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Samples Ms",
            "description": "Per-call round-trip time in milliseconds, in order (first is usually cold)"
          },
          "min_ms": {
            "type": "number",
            "title": "Min Ms",
            "description": "Fastest round-trip (best-case / warm connection)"
          },
          "avg_ms": {
            "type": "number",
            "title": "Avg Ms",
            "description": "Average round-trip across samples"
          },
          "max_ms": {
            "type": "number",
            "title": "Max Ms",
            "description": "Slowest round-trip (usually the cold/first call)"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "description": "True if all round-trips succeeded"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if a round-trip failed"
          }
        },
        "type": "object",
        "required": [
          "target",
          "endpoint",
          "samples",
          "samples_ms",
          "min_ms",
          "avg_ms",
          "max_ms",
          "ok"
        ],
        "title": "LatencyResponse"
      },
      "PriceFacet": {
        "properties": {
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min",
            "description": "Minimum price across the matching result population"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max",
            "description": "Maximum price across the matching result population"
          }
        },
        "type": "object",
        "title": "PriceFacet"
      },
      "ProductItem": {
        "properties": {
          "sku_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Id",
            "description": "SKU identifier (source: sku_id)"
          },
          "sku_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Name",
            "description": "Product name (source: sku_name, else product_name)"
          },
          "primary_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Image Url",
            "description": "Primary product image URL (source: primary_image_url)"
          },
          "asmo_material_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asmo Material Number",
            "description": "ASMO material number (source: asmo_material_number)"
          },
          "aramco_material_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aramco Material Number",
            "description": "Aramco material number (source: aramco_material_number)"
          },
          "seller_details": {
            "items": {
              "$ref": "#/components/schemas/SellerDetail"
            },
            "type": "array",
            "title": "Seller Details",
            "description": "Every seller offer, cheapest first (source: seller_details)"
          },
          "temporary_unavailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temporary Unavailable",
            "description": "Primary seller's offer temporarily unavailable (source: temporary_unavailable, else seller_details[0].temporary_unavailable)"
          }
        },
        "type": "object",
        "title": "ProductItem",
        "description": "A single product in the search response, shaped per the agreed frontend contract.\n\nThe primary (cheapest) seller is ``seller_details[0]``; its price is what\n``sort_by=price`` orders by."
      },
      "ProductSuggestion": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Suggested product name to display in the autocomplete dropdown"
          },
          "sku_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Id",
            "description": "SKU of the suggested product, to link to its detail page (source: sku_id)"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ProductSuggestion"
      },
      "QuerySuggestion": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Suggested search query string matching the prefix"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "QuerySuggestion"
      },
      "SearchApiResponse": {
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Search-context handle: send it back as request_id (with filters / sort / page) to refine this search. Refining returns the same request_id; a new query or image gets a new one"
          },
          "total_results": {
            "type": "integer",
            "title": "Total Results",
            "description": "Total number of matching products before pagination"
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Current 1-based page number"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "Number of products returned per page"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductItem"
            },
            "type": "array",
            "title": "Products",
            "description": "Products for the requested page"
          },
          "facets": {
